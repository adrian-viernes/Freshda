APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=freshda
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@freshda.test"
MAIL_FROM_NAME="Fresh-DA"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Fish recognition model service (FastAPI + YOLOv8 base URL).
# Leave empty to run with offline simulated scan results.
AI_SERVICE_URL=
AI_SERVICE_TIMEOUT=15

# Roboflow Serverless Workflow Integration
ROBOFLOW_API_KEY=
ROBOFLOW_WORKSPACE=evelyns-workspace-gfs2g
ROBOFLOW_WORKFLOW_ID=fresh-da-project-vfresh-da-project-4-vitsmallpatch16dinov3lvd1689m-t1-logic
ROBOFLOW_API_URL=https://serverless.roboflow.com
ROBOFLOW_TIMEOUT=30
ROBOFLOW_RETRY_TIMES=3
ROBOFLOW_RETRY_SLEEP_MS=500

